abstract class Tiket{
  String nama;
  double harga;
  String gambar;

  Tiket(this.nama,this.harga,this.gambar);

  String deskripsi();
}

mixin BisaDiskon{
  double hitungHargaDiskon(double persen){
    return hargaDiskon(persen);
  }

  double hargaDiskon(double persen){
    return 0;
  }
}

class TiketEkonomi extends Tiket{
  TiketEkonomi(
    String nama,
    double harga,
    String gambar,
  ):super(nama,harga,gambar);

  @override
  String deskripsi(){
    return "Kamar nyaman dengan fasilitas standar";
  }
}

class TiketVIP extends Tiket with BisaDiskon{
  TiketVIP(
    String nama,
    double harga,
    String gambar,
  ):super(nama,harga,gambar);

  @override
  String deskripsi(){
    return "Kamar VIP dengan fasilitas premium";
  }

  @override
  double hargaDiskon(double persen){
    return harga-(harga*persen/100);
  }
}

class TiketHabisException implements Exception{
  String pesan;

  TiketHabisException(this.pesan);

  @override
  String toString(){
    return pesan;
  }
}

