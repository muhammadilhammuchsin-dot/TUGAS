Stream<int> promoCountdown(){

  return Stream.periodic(

    const Duration(seconds:1),

    (value){

      int waktu=
      60-value;

      return waktu<=0
      ?0
      :waktu;

    },

  ).take(61);

}


class PromoWidget extends StatelessWidget{

  const PromoWidget({super.key});


  @override
  Widget build(BuildContext context){

    return StreamBuilder<int>(

      stream:
      promoCountdown(),

      builder:(context,snapshot){

        if(!snapshot.hasData){

          return const SizedBox();

        }


        return Container(

          margin:
          const EdgeInsets.all(15),

          padding:
          const EdgeInsets.all(15),

          decoration:
          BoxDecoration(

            color:
            purple,

            borderRadius:
            BorderRadius.circular(20),

          ),

          child:
          Text(

            "Promo berakhir dalam ${snapshot.data} detik",

            style:
            const TextStyle(

              color:
              Colors.white,

              fontWeight:
              FontWeight.bold,

            ),

          ),

        );

      },

    );

  }

}
