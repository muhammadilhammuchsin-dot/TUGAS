class _PaymentPageState extends State<PaymentPage>{

  String metode="Visa";
  bool loading=false;
  String pesan="";


  Future<void> bayar()async{

    setState((){
      loading=true;
      pesan="";
    });


    try{

      String hasil=
      await pesanTiket(
        widget.tiket,
      );

      setState((){
        pesan=hasil;
      });


      Navigator.pushReplacement(
        context,
        MaterialPageRoute(
          builder:(_)=>
          const SuccessPage(),
        ),
      );


    }on TiketHabisException catch(e){

      setState((){
        pesan=e.toString();
      });


    }catch(e){

      setState((){
        pesan="Pembayaran gagal";
      });


    }finally{

      setState((){
        loading=false;
      });

    }

  }


  @override
  Widget build(BuildContext context){

    return Scaffold(

      appBar:
      AppBar(
        backgroundColor:navy,
        title:
        const Text(
          "Payment",
        ),
      ),

      body:
      Padding(

        padding:
        const EdgeInsets.all(20),

        child:
        Column(

          crossAxisAlignment:
          CrossAxisAlignment.start,

          children:[

            Text(
              widget.tiket.nama,
              style:
              const TextStyle(
                fontSize:24,
                fontWeight:
                FontWeight.bold,
              ),
            ),

            const SizedBox(height:10),

            Text(
              "Rp${widget.tiket.harga.toStringAsFixed(0)}",
              style:
              const TextStyle(
                color:purple,
                fontSize:20,
                fontWeight:
                FontWeight.bold,
              ),
            ),

            const SizedBox(height:25),

            const Text(
              "Payment Method",
              style:
              TextStyle(
                fontSize:20,
                fontWeight:
                FontWeight.bold,
              ),
            ),

            RadioListTile(
              title:
              const Text("Visa"),
              value:"Visa",
              groupValue:metode,
              onChanged:(value){

                setState((){
                  metode=value.toString();
                });

              },
            ),

            RadioListTile(
              title:
              const Text("Mastercard"),
              value:"Mastercard",
              groupValue:metode,
              onChanged:(value){

                setState((){
                  metode=value.toString();
                });

              },
            ),

            RadioListTile(
              title:
              const Text("E-Wallet"),
              value:"E-Wallet",
              groupValue:metode,
              onChanged:(value){

                setState((){
                  metode=value.toString();
                });

              },
            ),

            const Spacer(),

            SizedBox(
              width:
              double.infinity,

              child:
              ElevatedButton(

                style:
                ElevatedButton.styleFrom(
                  backgroundColor:
                  navy,
                  padding:
                  const EdgeInsets.all(15),
                ),

                onPressed:
                loading
                ?null
                :bayar,

                child:
                Text(
                  loading
                  ?"Processing..."
                  :"Pay Now",

                  style:
                  const TextStyle(
                    color:
                    Colors.white,
                  ),
                ),
              ),
            ),

            Text(
              pesan,
              style:
              const TextStyle(
                color:Colors.green,
              ),
            ),
          ],
        ),
      ),
    );
  }
