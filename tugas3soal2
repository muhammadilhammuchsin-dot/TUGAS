Future<String> pesanTiket(Tiket tiket)async{

  await Future.delayed(
    const Duration(seconds:2),
  );

  if(tiket.harga<=0){

    throw TiketHabisException(
      "Tiket tidak tersedia",
    );

  }

  daftarPesanan.add(tiket);

  return "Pembayaran berhasil";

}

